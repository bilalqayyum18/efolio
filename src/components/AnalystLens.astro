---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<details class="mt-12 strip-card group">
  <summary class="cursor-pointer font-display text-lg font-bold text-strip-accent marker:content-none">
    <span class="flex items-center gap-2">
      <span class="font-data text-strip-signal transition group-open:rotate-90">▸</span>
      {title}
    </span>
  </summary>
  <div class="mt-6 border-t border-strip-border pt-6">
    <slot />
  </div>
</details>
